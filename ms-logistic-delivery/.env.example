# Plantilla de credenciales. Copiar a .env y poner valores propios:
#
#   cp .env.example .env
#
# .env NO se versiona (esta en .gitignore) ni entra en la imagen (esta en .dockerignore).
# Usa solo caracteres ASCII y sin comillas: el mismo fichero lo leen Docker Compose y
# Spring Boot (que lo interpreta como .properties).

# --- Postgres / PostGIS ---
DB_USER=logistic
DB_PASSWORD=cambia-esta-clave

# --- RabbitMQ ---
RABBITMQ_USER=logistic
RABBITMQ_PASSWORD=cambia-esta-clave
