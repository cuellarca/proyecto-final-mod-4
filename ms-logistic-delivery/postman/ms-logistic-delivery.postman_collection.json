          "name": "15 · Historial del paciente 2: entrega no concretada",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El publicador del Outbox drena cada OUTBOX_POLL_DELAY_MS (2 s por defecto):",
                  "// se le da margen a la proyección antes de consultar el read model.",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const historial = pm.response.json();",
                  "const entregaId2 = pm.collectionVariables.get('entregaId2');",
                  "const fila = Array.isArray(historial) ? historial.find(e => e.entregaId === entregaId2) : undefined;",
                  "const proyectada = !!fila && fila.estado === 'NO_CONCRETADA';",
                  "",
                  "const intentos = Number(pm.collectionVariables.get('_intentosHistorial') || 0);",
                  "if (!proyectada && intentos < 5) {",
                  "    pm.collectionVariables.set('_intentosHistorial', intentos + 1);",
                  "    console.log('Proyección aún no disponible; reintento ' + (intentos + 1) + '/5');",
                  "    postman.setNextRequest('15 · Historial del paciente 2: entrega no concretada');",
                  "} else {",
                  "    pm.collectionVariables.set('_intentosHistorial', 0);",
                  "",
                  "    pm.test('La entrega 2 figura NO_CONCRETADA en el historial del paciente', () => {",
                  "        pm.expect(fila, 'entrega ' + entregaId2 + ' en el historial').to.exist;",
                  "        pm.expect(fila.estado).to.eql('NO_CONCRETADA');",
                  "    });",
                  "",
                  "    pm.test('Registra el motivo del último fallo', () => {",
                  "        pm.expect(fila.motivoFallo).to.eql('AUSENTE');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
