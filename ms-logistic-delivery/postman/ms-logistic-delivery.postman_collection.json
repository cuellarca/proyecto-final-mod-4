    {
      "name": "Flujo A · Entrega exitosa",
      "description": "La entrega 1 se planifica, se recorre, se confirma con constancia y queda en el historial del paciente.\n\nEn este flujo se planifica la ruta del día con los dos paquetes: el 1 es el de este flujo y el 2 el del flujo B.",
      "item": [
        {
          "name": "01 · Geocodificar una dirección",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Devuelve lat/lon numéricos', () => {",
                  "    pm.expect(body.lat).to.be.a('number');",
                  "    pm.expect(body.lon).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Las coordenadas son válidas', () => {",
                  "    pm.expect(body.lat).to.be.within(-90, 90);",
                  "    pm.expect(body.lon).to.be.within(-180, 180);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"Av. Banzer 3er anillo, Santa Cruz\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/geocoding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "geocoding"
              ]
            },
            "description": "`POST /api/v1/geocoding` — resuelve una dirección a `{lat, lon}` a través del ACL del proveedor de mapas (stub configurable con `MAPS_STUB_LATENCY_MS` y `MAPS_STUB_FAILURE_RATE`)."
          },
          "response": []
        },
        {
          "name": "02 · Planificar la ruta del día",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Un repartidor distinto por ejecución: así la colección se puede correr",
                  "// tantas veces como haga falta sin mezclar rutas de corridas anteriores.",
                  "pm.collectionVariables.set('repartidorId', 'rep-postman-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Devuelve la ruta creada y una entrega por paquete', () => {",
                  "    pm.expect(body.rutaId).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.entregas).to.be.an('array').with.lengthOf(2);",
                  "});",
                  "",
                  "// Se correlaciona por paqueteId (no por posición): la optimización reordena las paradas.",
                  "const e1 = body.entregas.find(e => e.paqueteId === pm.collectionVariables.get('paqueteId1'));",
                  "const e2 = body.entregas.find(e => e.paqueteId === pm.collectionVariables.get('paqueteId2'));",
                  "",
                  "pm.test('Cada paquete tiene su entrega programada', () => {",
                  "    pm.expect(e1, 'entrega de ' + pm.collectionVariables.get('paqueteId1')).to.exist;",
                  "    pm.expect(e2, 'entrega de ' + pm.collectionVariables.get('paqueteId2')).to.exist;",
                  "});",
                  "",
                  "pm.collectionVariables.set('rutaId', body.rutaId);",
                  "pm.collectionVariables.set('entregaId1', e1 ? e1.entregaId : '');",
                  "pm.collectionVariables.set('entregaId2', e2 ? e2.entregaId : '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repartidorId\": \"{{repartidorId}}\",\n  \"fecha\": \"{{fecha}}\",\n  \"origenLat\": -17.78,\n  \"origenLon\": -63.18,\n  \"paquetes\": [\n    {\n      \"paqueteId\": \"{{paqueteId1}}\",\n      \"pacienteId\": \"{{pacienteId}}\",\n      \"lat\": -17.7833,\n      \"lon\": -63.1821\n    },\n    {\n      \"paqueteId\": \"{{paqueteId2}}\",\n      \"pacienteId\": \"{{pacienteId2}}\",\n      \"lat\": -17.79,\n      \"lon\": -63.19\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/rutas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rutas"
              ]
            },
            "description": "`POST /api/v1/rutas` — recibe los paquetes del día ya geolocalizados, optimiza la secuencia de paradas y programa una entrega por paquete.\n\nGuarda en variables `rutaId`, `entregaId1` y `entregaId2` para el resto de la colección."
          },
          "response": []
        },
        {
          "name": "03 · Rutas del repartidor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const rutas = pm.response.json();",
                  "pm.test('Devuelve al menos una ruta', () => {",
                  "    pm.expect(rutas).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "const rutaId = pm.collectionVariables.get('rutaId');",
                  "const ruta = rutas.find(r => r.rutaId === rutaId) || rutas[0];",
                  "",
                  "pm.test('La ruta está PLANIFICADA y trae sus 2 paradas', () => {",
                  "    pm.expect(ruta.estado).to.eql('PLANIFICADA');",
                  "    pm.expect(ruta.paradas).to.be.an('array').with.lengthOf(2);",
                  "});",
                  "",
                  "pm.test('El orden de las paradas es contiguo 1..n', () => {",
                  "    const ordenes = ruta.paradas.map(p => p.orden).sort();",
                  "    pm.expect(ordenes).to.eql([1, 2]);",
                  "});",
                  "",
                  "pm.test('Toda parada tiene geolocalización (invariante HU-2)', () => {",
                  "    ruta.paradas.forEach(p => {",
                  "        pm.expect(p.lat, 'lat de ' + p.paqueteId).to.be.a('number');",
                  "        pm.expect(p.lon, 'lon de ' + p.paqueteId).to.be.a('number');",
                  "    });",
                  "});",
                  "",
                  "const p1 = ruta.paradas.find(p => p.paqueteId === pm.collectionVariables.get('paqueteId1'));",
                  "const p2 = ruta.paradas.find(p => p.paqueteId === pm.collectionVariables.get('paqueteId2'));",
                  "pm.collectionVariables.set('paradaId1', p1 ? p1.paradaId : '');",
                  "pm.collectionVariables.set('paradaId2', p2 ? p2.paradaId : '');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/repartidores/{{repartidorId}}/rutas?fecha={{fecha}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "repartidores",
                "{{repartidorId}}",
                "rutas"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "{{fecha}}",
                  "description": "Fecha de la jornada, ISO yyyy-MM-dd (obligatoria)"
                }
              ]
            },
            "description": "`GET /api/v1/repartidores/{repartidorId}/rutas?fecha=` — hoja de ruta del repartidor con sus paradas ordenadas.\n\nCaptura `paradaId1` y `paradaId2` correlacionando por `paqueteId`."
          },
          "response": []
        },
        {
          "name": "04 · Iniciar la ruta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Sin cuerpo de respuesta (es un comando)', () => {",
                  "    pm.expect(pm.response.text()).to.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rutas/{{rutaId}}/inicio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rutas",
                "{{rutaId}}",
                "inicio"
              ]
            },
            "description": "`POST /api/v1/rutas/{rutaId}/inicio` — transición PLANIFICADA → EN_CURSO. Es requisito para operar cualquier parada."
          },
          "response": []
        },
        {
          "name": "05 · Avanzar a la parada 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rutas/{{rutaId}}/paradas/{{paradaId1}}/avance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rutas",
                "{{rutaId}}",
                "paradas",
                "{{paradaId1}}",
                "avance"
              ]
            },
            "description": "`POST /api/v1/rutas/{rutaId}/paradas/{paradaId}/avance` — llegada del repartidor a la parada (PENDIENTE → EN_CURSO)."
          },
          "response": []
        },
        {
          "name": "06 · Completar la parada 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rutas/{{rutaId}}/paradas/{{paradaId1}}/completar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rutas",
                "{{rutaId}}",
                "paradas",
                "{{paradaId1}}",
                "completar"
              ]
            },
            "description": "`POST .../paradas/{paradaId}/completar` — la parada queda COMPLETADA (EN_CURSO → COMPLETADA). Cuando todas las paradas son terminales, la ruta pasa a FINALIZADA."
          },
          "response": []
        },
        {
          "name": "09 · Confirmar la entrega 1 (con constancia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": -17.7833,\n  \"lon\": -63.1821,\n  \"urlEvidencia\": \"https://storage.example.com/evidencia/pkg-1.jpg\",\n  \"nombreReceptor\": \"Maria Perez\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/entregas/{{entregaId1}}/confirmacion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entregas",
                "{{entregaId1}}",
                "confirmacion"
              ]
            },
            "description": "`POST /api/v1/entregas/{entregaId}/confirmacion` — cierra la entrega con su constancia (coordenadas + evidencia + receptor). Los cuatro campos son obligatorios."
          },
          "response": []
        },
        {
          "name": "12 · Historial de entregas del paciente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El publicador del Outbox drena cada OUTBOX_POLL_DELAY_MS (2 s por defecto):",
                  "// se le da margen a la proyección antes de consultar el read model.",
                  "setTimeout(() => {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const historial = pm.response.json();",
                  "const paqueteId1 = pm.collectionVariables.get('paqueteId1');",
                  "const proyectada = Array.isArray(historial) && historial.some(e => e.paqueteId === paqueteId1);",
                  "",
                  "// La proyección es eventual: se reintenta unas cuantas veces antes de darla por fallida.",
                  "const intentos = Number(pm.collectionVariables.get('_intentosHistorial') || 0);",
                  "if (!proyectada && intentos < 5) {",
                  "    pm.collectionVariables.set('_intentosHistorial', intentos + 1);",
                  "    console.log('Proyección aún no disponible; reintento ' + (intentos + 1) + '/5');",
                  "    postman.setNextRequest('12 · Historial de entregas del paciente');",
                  "} else {",
                  "    pm.collectionVariables.set('_intentosHistorial', 0);",
                  "",
                  "    pm.test('El historial del paciente incluye su paquete', () => {",
                  "        pm.expect(proyectada, 'entrega de ' + paqueteId1 + ' proyectada').to.be.true;",
                  "    });",
                  "",
                  "    pm.test('Cada fila del historial trae el contrato de lectura', () => {",
                  "        historial.forEach(e => {",
                  "            pm.expect(e).to.have.property('entregaId');",
                  "            pm.expect(e).to.have.property('pacienteId');",
                  "            pm.expect(e).to.have.property('estado');",
                  "            pm.expect(e).to.have.property('ultimoEventoEn');",
                  "        });",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pacientes/{{pacienteId}}/entregas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pacientes",
                "{{pacienteId}}",
                "entregas"
              ]
            },
            "description": "`GET /api/v1/pacientes/{pacienteId}/entregas` — respaldo de entregas del paciente, servido desde el read model."
          },
          "response": []
        },
        {
          "name": "13 · Historial del paciente filtrado por fechas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve una lista', () => {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pacientes/{{pacienteId}}/entregas?desde={{fechaDesde}}&hasta={{fechaHasta}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pacientes",
                "{{pacienteId}}",
                "entregas"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "{{fechaDesde}}",
                  "description": "Opcional. Límite inferior, ISO yyyy-MM-dd"
                },
                {
                  "key": "hasta",
                  "value": "{{fechaHasta}}",
                  "description": "Opcional. Límite superior, ISO yyyy-MM-dd"
                }
              ]
            },
            "description": "Mismo endpoint con los filtros opcionales `desde` y `hasta` (ambos ISO `yyyy-MM-dd`)."
          },
          "response": []
        },
        {
          "name": "14 · Constancia de la entrega confirmada",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mismo motivo que en la petición anterior: la constancia llega por proyección.",
                  "setTimeout(() => {}, 1000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const intentos = Number(pm.collectionVariables.get('_intentosConstancia') || 0);",
                  "if (pm.response.code === 404 && intentos < 5) {",
                  "    pm.collectionVariables.set('_intentosConstancia', intentos + 1);",
                  "    console.log('Constancia aún no proyectada; reintento ' + (intentos + 1) + '/5');",
                  "    postman.setNextRequest('14 · Constancia de la entrega confirmada');",
                  "} else {",
                  "    pm.collectionVariables.set('_intentosConstancia', 0);",
                  "",
                  "    pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "    const constancia = pm.response.json();",
                  "",
                  "    pm.test('Es la constancia de la entrega confirmada', () => {",
                  "        pm.expect(constancia.entregaId).to.eql(pm.collectionVariables.get('entregaId1'));",
                  "    });",
                  "",
                  "    pm.test('Conserva la evidencia registrada al confirmar', () => {",
                  "        pm.expect(constancia.urlEvidencia).to.eql('https://storage.example.com/evidencia/pkg-1.jpg');",
                  "        pm.expect(constancia.nombreReceptor).to.eql('Maria Perez');",
                  "        pm.expect(constancia.lat).to.be.a('number');",
                  "        pm.expect(constancia.lon).to.be.a('number');",
                  "        pm.expect(constancia.timestamp).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entregas/{{entregaId1}}/constancia",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entregas",
                "{{entregaId1}}",
                "constancia"
              ]
            },
            "description": "`GET /api/v1/entregas/{entregaId}/constancia` — evidencia (foto/firma), receptor, coordenadas e instante de la entrega. Devuelve 404 si la entrega no tiene constancia."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flujo B · Entrega no concretada",
      "description": "Sobre la misma ruta del flujo A: la parada 2 falla, la entrega 2 se reintenta hasta agotar los intentos (`REINTENTOS_MAXIMO`, 2 por defecto) y queda no concretada en el historial del paciente 2.\n\nSe ejecuta después del flujo A.",
      "item": [
        {
          "name": "07 · Avanzar a la parada 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rutas/{{rutaId}}/paradas/{{paradaId2}}/avance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rutas",
                "{{rutaId}}",
                "paradas",
                "{{paradaId2}}",
                "avance"
              ]
            },
            "description": "Llegada a la segunda parada, la que terminará fallando (HU-5)."
          },
          "response": []
        },
